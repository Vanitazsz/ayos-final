# Client-side vars (bundled into Expo app via EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_AI_CONSENT_VERSION=2026-07-21
EXPO_PUBLIC_SUPPORT_EMAIL=support@a-yos.local

# Edge Function AI provider keys (also needed in supabase/.env.local)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Bootstrap admin (used by scripts/bootstrap-admin.ts, reads .env.local)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin1234567!
BOOTSTRAP_ADMIN_NAME=A-YOS Administrator
