NODE_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
EXPO_PUBLIC_SUPABASE_URL=https://qsurouiyvisykjkgjqmz.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
EXPO_PUBLIC_AI_CONSENT_VERSION=2026-07-21
EXPO_PUBLIC_SUPPORT_EMAIL=support@a-yos.local
EDGE_FUNCTION_SHARED_SECRET=replace-with-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin1234567!
BOOTSTRAP_ADMIN_NAME=A-YOS Administrator
# Server-only Edge AI provider settings. Never expose these keys in EXPO_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# ai.enabled is the public.system_settings key consumed by the Edge AI functions;
# its hosted value must be verified in Supabase and is not an environment variable.
GOOGLE_OAUTH_ENABLED=false
OPENROUTESERVICE_API_KEY=
AI_TIMEOUT_MS=55000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_ACCESS_TOKEN=
