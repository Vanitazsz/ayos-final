{
  "expo": {
    "name": "A-yos",
    "slug": "ayos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ayos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayos.app.dev"
    },
    "android": {
      "package": "com.ayos.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow A-YOS to use your camera to photograph the service problem."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow A-YOS to select a photo of the service problem.",
          "cameraPermission": "Allow A-YOS to photograph the service problem.",
          "microphonePermission": "Allow A-YOS to record a voice description of the service problem."
        }
      ],
      "@maplibre/maplibre-react-native",
      "@react-native-community/datetimepicker",
      "./plugins/withIosPodDeploymentTarget"
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    }
  }
}
