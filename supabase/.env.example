# Edge Function environment — loaded by `supabase functions serve --env-file supabase/.env.local`
# API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-plus

# Geocoding
OPENROUTESERVICE_API_KEY=

# Misc
AI_TIMEOUT_MS=55000
EDGE_FUNCTION_SHARED_SECRET=replace-with-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
