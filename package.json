{
  "name": "a-yos",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "build": "expo export --platform web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "check:no-mocks": "node scripts/check-no-production-mocks.mjs",
    "native:prebuild": "bash scripts/native-build.sh prebuild",
    "native:prebuild:clean": "bash scripts/native-build.sh clean",
    "native:archive": "bash scripts/native-build.sh archive",
    "ios": "bash scripts/native-build.sh ensure && expo run:ios --device",
    "ios:simulator": "bash scripts/native-build.sh ensure && expo run:ios",
    "android": "bash scripts/native-build.sh ensure && expo run:android",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "verify": "pnpm verify:stack && pnpm format:check && pnpm lint && pnpm typecheck && pnpm functions:check && pnpm functions:test && pnpm test && pnpm traceability:check && pnpm contracts:check && pnpm build",
    "verify:stack": "bash scripts/verify-stack.sh",
    "verify:ci": "bash scripts/ci.sh",
    "supabase:start": "supabase start",
    "supabase:local": "bash scripts/local-supabase.sh",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level error",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/database.generated.ts",
    "functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "functions:check": "deno check --config supabase/functions/deno.json supabase/functions/ai-analyze-request/index.ts supabase/functions/ai-assist-media/index.ts supabase/functions/ai-process-job/index.ts supabase/functions/geocode-search/index.ts supabase/functions/geocode-reverse/index.ts supabase/functions/route/index.ts supabase/functions/queue-consumer/index.ts supabase/functions/report-export/index.ts supabase/functions/admin-invite-account/index.ts supabase/functions/record-auth-session/index.ts supabase/functions/booking-proof-retention/index.ts supabase/functions/api/index.ts",
    "functions:test": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/_shared/expo-push.test.ts supabase/functions/_frontend_shared/geocoding.test.ts supabase/functions/_frontend_shared/ai.test.ts supabase/functions/record-auth-session/index.test.ts supabase/functions/api/index.test.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "refactor:inventory": "tsx scripts/refactor/analyze-repository.ts && prettier --write docs/refactor/*.md",
    "refactor:inventory:final": "tsx scripts/refactor/analyze-repository.ts --final && prettier --write docs/refactor/*.md",
    "traceability:check": "tsx scripts/check-traceability.ts",
    "contracts:check": "bash scripts/check-frontend-backend-contracts.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^54.0.35",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "^7.0.11",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "lucide-react-native": "^0.544.0",
    "maplibre-gl": "^5.24.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.82.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "whatwg-url-without-unicode": "8.0.0-3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "9.38.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "24.10.0",
    "@types/react": "~19.1.10",
    "eslint": "9.38.0",
    "prettier": "3.6.2",
    "supabase": "2.109.1",
    "tsx": "4.20.6",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.10"
  }
}
